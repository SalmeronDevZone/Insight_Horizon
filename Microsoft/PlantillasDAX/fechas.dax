dimFechasCALENDARAUTO = 
CALENDARAUTO ()
// CALENDARAUTO: Devuelve una tabla con una única columna de fechas ("Date") calculada automáticamente. 
// Examina todo el modelo de datos para encontrar el año más antiguo y el más reciente (excluyendo tablas calculadas), 
// y genera un rango completo de días que va desde el 1 de enero del año mínimo hasta el 31 de diciembre del año máximo.

--------------------------------------------------------------------------------------------------------------------------------

dimFechasCALENDAR = 

CALENDAR (
// CALENDAR: Devuelve una tabla con una única columna llamada "Date" que contiene un rango de fechas consecutivas 
  // entre la fecha de inicio (primer argumento) y la fecha de fin (segundo argumento).

    DATE( 
    // DATE: Devuelve una fecha en formato datetime combinando tres valores numéricos enteros que se le pasan como argumentos: año, mes y día.
    
        YEAR( 
        // YEAR: Extrae y devuelve el año de una fecha específica como un número entero de cuatro dígitos (por ejemplo, 2026).
        
            MIN( factPedidos[fechaPedido] )
            // MIN: Busca y devuelve el valor más pequeño (la fecha más antigua) de la columna especificada.
        ), 
        1, 
        1
    ),
    
    DATE( 
    // DATE: Vuelve a usarse aquí para construir la fecha límite superior (el final del calendario).
    
        YEAR( 
        // YEAR: Extrae el año de la fecha máxima obtenida en el siguiente paso.
        
            MAX( factPedidos[fechaPedido] )
            // MAX: Busca y devuelve el valor más grande (la fecha más reciente) de la columna especificada.
        ), 
        12, 
        31
    )
)





  --------------------------------------------------------------------------------------------------------------------------------




  dimFechas = 

--Variables para almacenar los años mínimo y máximo---------------
VAR _ejercicioMin =     YEAR( 
                        // YEAR: Extrae y devuelve el año de una fecha específica como un número entero de cuatro dígitos.
                            MIN( factPedidos[fechaPedido] ) 
                            // MIN: Busca y devuelve el valor más pequeño (la fecha más antigua) de la columna especificada.
                        )
VAR _ejercicioMax =     YEAR( 
                        // YEAR: Extrae y devuelve el año de una fecha específica como un número entero de cuatro dígitos.
                            MAX( factPedidos[fechaPedido] ) 
                            // MAX: Busca y devuelve el valor más grande (la fecha más reciente) de la columna especificada.
                        )

--Variables para almacenar las fechas mínima y máxima-------------
VAR _fechaMin =         DATE( 
                        // DATE: Devuelve una fecha en formato datetime combinando tres valores numéricos enteros: año, mes y día.
                            _ejercicioMin, 1, 1 
                        )
VAR _fechaMax =         DATE( 
                        // DATE: Devuelve una fecha en formato datetime combinando tres valores numéricos enteros: año, mes y día.
                            _ejercicioMax, 12, 31 
                        )

--Variable para determinar el primer mes fiscal-------------------
VAR _primerMesFisc =    7  --Adaptar según necesidades

RETURN

ADDCOLUMNS (
// ADDCOLUMNS: Agrega columnas calculadas al conjunto de filas o expresión de tabla especificada.

    --Generación de tabla para columna de fecha-------------------
    CALENDAR ( _fechaMin, _fechaMax ),
    // CALENDAR: Devuelve una tabla con una única columna llamada "Date" que contiene un rango de fechas consecutivas entre la fecha de inicio y la de fin.

    --Generación de columnas--------------------------------------
    "Año",              YEAR( [Date] ),
                        // YEAR: Extrae el año (número entero de 4 dígitos) a partir de la fecha de la fila actual de la tabla calendario.
    "Trimestre",        "Trim-" & QUARTER( [Date] ),
                                  // QUARTER: Devuelve el número de trimestre del año (un entero del 1 al 4) asociado a una fecha.
    "Nombre mes",       FORMAT( [Date], "mmm" ),
                        // FORMAT: Convierte un valor a texto aplicando un formato estructurado (aquí extrae las tres primeras letras del mes).
    "N.º mes",          MONTH( [Date] ),
                        // MONTH: Devuelve el número del mes del año (un número entero del 1 al 12) para la fecha evaluada.
    "Mes-año",          FORMAT( [Date], "mmm-yy" ),
                        // FORMAT: Convierte la fecha en una cadena de texto combinando el mes abreviado y los dos últimos dígitos del año.
    "N.º año-mes",      VALUE( 
                        // VALUE: Convierte una cadena de caracteres de texto que representa un número en un valor numérico real.
                            FORMAT( [Date], "yyyymm" ) 
                            // FORMAT: Transforma la fecha en un texto continuo con formato de año y mes ("AAAAMM").
                        ),
    "Nombre día semana",FORMAT( [Date], "DDDD" ),
                        // FORMAT: Convierte la fecha a texto devolviendo el nombre completo del día de la semana (ej. "Lunes").
    "N.º día semana",   WEEKDAY( [Date], 2 ),
                        // WEEKDAY: Devuelve un número del 1 al 7 que identifica el día de la semana. El tipo 2 define que la semana comienza el lunes (1) y termina el domingo (7).
                        --Adaptar según necesidades

    --Otras columnas complementarias------------------------------
    "Es día laborable", IF(
                        // IF: Comprueba si se cumple una condición lógica (primer argumento) y devuelve un resultado si es verdadero (segundo) u otro si es falso (tercero).
                            WEEKDAY( [Date], 2 ) <= 5,
                            // WEEKDAY: Obtiene el número de orden del día de la semana (1-lunes a 7-domingo).
                            --Adaptar según necesidades
                            "Día laborable",
                            "Fin de semana"
                        ),
    "Semana del año",   WEEKNUM( [Date], 21 ),
                        // WEEKNUM: Devuelve el número de semana dentro del año. El parámetro 21 aplica el estándar internacional ISO 8601 (la semana inicia el lunes y la primera semana tiene 4 o más días del nuevo año).
                        --Adaptar según necesidades
    "Semestre",         IF(
                        // IF: Evalúa una condición lógica para determinar la mitad del año en la que se sitúa el mes.
                            MONTH( [Date] ) <= 6,
                            // MONTH: Extrae el número entero del mes (1 al 12).
                            "Semestre 1",
                            "Semestre 2"
                        ),

    --OPCIONAL: clave subrogada para relacionar-------------------
    "IDS_fecha",        YEAR( [Date] ) * 10000 + 
                        // YEAR: Extrae el componente de año numérico.
                        MONTH( [Date] ) * 100 + 
                        // MONTH: Extrae el componente de mes numérico.
                        DAY( [Date] ),
                        // DAY: Devuelve un número entero del 1 al 31 que representa el día del mes de la fecha evaluada.

    --Columnas para gestión de años fiscales----------------------
    "Año fiscal",       IF(
                        // IF: Evalúa si la fecha pertenece al año fiscal actual o al siguiente en función del mes de inicio fiscal establecido.
                            MONTH( [Date] ) >= _primerMesFisc,
                            // MONTH: Extrae el número del mes.
                            "AF " & YEAR( [Date] ) + 1,
                                    // YEAR: Extrae el año numérico para sumarle una unidad.
                            "AF " & YEAR( [Date] )
                                    // YEAR: Extrae el año numérico nominal.
                        ),
    "Semestre fiscal",  VAR _mesFiscal = MOD(
                                         // MOD: Devuelve el residuo o resto de una división matemática. Se utiliza aquí para calcular de forma matemática y cíclica el mes relativo al año fiscal.
                                             MONTH( [Date] ) -
                                             // MONTH: Extrae el número de mes actual de la fila.
                                             _primerMesFisc + 12,
                                             12
                                         )
                                         + 1
                        RETURN
                        "Semestre " &
                        IF( _mesFiscal <= 6, 1, 2),
                        // IF: Determina si el mes fiscal calculado se encuentra en la primera o segunda mitad del año fiscal.
    "Trim. fiscal",     VAR _mesFiscal =     MOD(
                                             // MOD: Devuelve el residuo de la división para volver a hallar el mes relativo del calendario fiscal.
                                                 MONTH( [Date] ) -
                                                 // MONTH: Extrae el número de mes actual de la fila.
                                                 _primerMesFisc + 12,
                                                 12
                                             )
                                             + 1
                        RETURN
                        "Trim-" &
                        SWITCH(
                        // SWITCH: Evalúa una expresión de control frente a una lista de valores secuenciales y devuelve el primer resultado coincidente.
                            TRUE(),
                            // TRUE: Devuelve el valor lógico verdadero. Al usarse dentro de SWITCH(TRUE(), ...), permite evaluar múltiples expresiones condicionales complejas en lugar de un único valor fijo.
                            _mesFiscal >= 1 && _mesFiscal <= 3, 1,
                            _mesFiscal >= 4 && _mesFiscal <= 6, 2,
                            _mesFiscal >= 7 && _mesFiscal <= 9, 3,
                            4
                        )
)
